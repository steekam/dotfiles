# General
alias c='clear'
alias zsh_config='vim ~/.zshrc'
alias sshconfig="vim ~/.ssh/config"

# Normalize alternate package names on Debian and older Ubuntu releases.
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  alias fd='fdfind'
fi
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat='batcat'
fi

# List all files colorized in long format
alias l="ls -laF"

# PHP
alias art='php artisan'
alias mfs='php artisan migrate:fresh --seed'
alias mf='php artisan migrate:fresh'
alias tinker='php artisan tinker'

alias cu='composer update'
alias cr='composer require'
alias ci='composer install'
alias cda="composer dump-autoload -o"

alias pf="phpunit --filter"
alias pestf="pest --filter"
alias at="php artisan test"
alias atf="php artisan test --filter"

# Git
alias nah='git reset --hard;git clean -df'
alias gc="git checkout"
alias gpo="git push origin"
alias gst="git status"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias g='git'
alias gb='git branch'
alias gba='git branch --all'
alias gbD='git branch --delete --force'
alias gcb='git checkout -b'
alias gcp='git cherry-pick'
alias gcs='git commit --gpg-sign'
alias gl='git pull'
alias glol='git log --graph --pretty="%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset"'
alias gk='gitk --all --branches &!'


# Windscribe
alias ws='windscribe'
alias ws_acc='windscribe account'
alias ws_us='windscribe connect US'
alias ws_gb='windscribe connect GB'

# Docker
alias docker-ps='docker ps --format "table {{.ID}}\t{{.Names}}\t{{.Status}}"'

# Change git submodules URLs to SSH using perl
alias gitmodules_to_ssh="perl -i -p -e 's|https://(.*?)/|git@\1:|g' .gitmodules"

# Bundle exec
alias be='bundle exec'


# Patrium OpenVPN3 connection
alias vpn-start='openvpn3 session-start --config patrium-eu-mod'
alias vpn-stop='openvpn3 session-manage --disconnect --config patrium-eu-mod'
