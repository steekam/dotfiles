setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_MINUS

alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'
alias -- -='cd -'
alias md='mkdir -p'
alias rd='rmdir'

function take() {
  if [[ $# -eq 0 ]]; then
    printf '%s\n' 'usage: take <directory> [directory ...]' >&2
    return 2
  fi

  mkdir -p -- "$@" && cd -- "${@:$#}"
}

function d() {
  if (( $# )); then
    dirs "$@"
  else
    dirs -v | head -n 10
  fi
}
compdef _dirs d
