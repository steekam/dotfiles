#!/usr/bin/env bash
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$root"

if ! command -v mise >/dev/null 2>&1; then
  printf '%s\n' 'Install mise first: https://mise.jdx.dev/getting-started.html' >&2
  exit 1
fi

if [[ $# -eq 0 ]]; then
  mise bootstrap
  "$root/setup-zsh-completions"
  "$root/setup-apps"
else
  mise bootstrap "$@"
fi
